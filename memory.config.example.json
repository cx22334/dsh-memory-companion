{
  "contextId": "default",
  "timezone": "Asia/Tokyo",
  "roles": [
    { "id": "main", "alias": "main", "name": "主角色", "directory": "主角色" }
  ],
  "google": {
    "protocol": "google",
    "model": "gemini-embedding-001",
    "dimensions": 768,
    "apiKeyEnv": "GOOGLE_API_KEY",
    "endpoint": "https://generativelanguage.googleapis.com/v1beta"
  },
  "chat": {
    "model": "deepseek-chat",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "endpoint": "https://api.deepseek.com/v1"
  },
  "recall": {
    "engine": "tagmemo",
    "tokenBudget": 1200,
    "maxNotes": 5,
    "candidateLimit": 100,
    "timeoutMs": 1500,
    "historyBudget": 4800
  },
  "diary": {
    "enabled": true,
    "maxPerTurn": 2,
    "batchTokens": 4000,
    "maxNotes": 6,
    "dailyTokenBudget": 20000,
    "quietMs": 60000,
    "turnInterval": 8
  },
  "management": { "enabled": true, "host": "127.0.0.1", "port": 0 },
  "vcpDsl": {
    "maxDeclarations": 12,
    "defaultK": 5,
    "maxK": 50,
    "defaultThreshold": 0.6,
    "mainSearchWeights": [0.7, 0.3],
    "historySegmentLimit": 3,
    "historyDecay": 0.85,
    "books": {},
    "semanticGroups": { "groups": {} },
    "pipeline": {},
    "river": {}
  },
  "jev": {
    "endpoint": "",
    "model": "",
    "apiKeyEnv": "JEV_API_KEY",
    "threshold": 0.7,
    "maxCandidates": 12,
    "concurrency": 4,
    "timeoutMs": 4000,
    "candidateChars": 1200,
    "queryChars": 800,
    "prompts": {}
  },
  "host": { "contextOrder": 140, "captureTools": false, "persistenceBatchSize": 200 },
  "security": { "mode": "host-enforced", "deploymentAcknowledged": false }
}
